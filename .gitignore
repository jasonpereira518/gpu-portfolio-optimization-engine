# Cached market data — regenerate with `make data`, never commit
data/cache/
*.parquet

# Top-level benchmark outputs are regenerated by `make bench`. Results worth
# keeping live in a per-host subdirectory (benchmarks/results/<host>/), which
# these patterns do not match, and are committed with their environment.json.
benchmarks/results/*.csv
benchmarks/results/*.png
benchmarks/results/environment.json

.DS_Store
